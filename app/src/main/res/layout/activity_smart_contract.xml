<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚡ Smart Contract Automation"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="16dp"/>

        <!-- INPUT CARD -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:radius="16dp"
            android:elevation="6dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <EditText
                    android:id="@+id/totalAmountInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Total Amount (ETH)" />

                <EditText
                    android:id="@+id/membersInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Number of Members"
                    android:layout_marginTop="10dp"/>

                <Button
                    android:id="@+id/deployBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Deploy Contract"
                    android:layout_marginTop="10dp"/>

                <Button
                    android:id="@+id/calculateBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Calculate Shares"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:id="@+id/shareResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Share result"
                    android:padding="10dp"
                    android:layout_marginTop="10dp"/>

                <EditText
                    android:id="@+id/paidMemberInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Member who paid"
                    android:layout_marginTop="10dp"/>

                <Button
                    android:id="@+id/payBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Record Payment"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:id="@+id/contractStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Status"
                    android:padding="10dp"
                    android:layout_marginTop="10dp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- RECORD LIST -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:radius="16dp"
            android:elevation="6dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp">

            <ListView
                android:id="@+id/recordList"
                android:layout_width="match_parent"
                android:layout_height="300dp"/>

        </androidx.cardview.widget.CardView>

        <!-- BACK BUTTON (IMPROVED POSITION) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:radius="16dp"
            android:elevation="6dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/backBtn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="#FF5252"
                android:text="← Back to Home"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>